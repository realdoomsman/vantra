# VANTRA — environment. Copy to .env and edit. Every value has a dev default;
# only the "robinhood" and "router" paths need real secrets/keys.
#
# The local runnable path needs none of them:
#   CHAIN_MODE=memory  LLM_PROVIDER=mock  SANDBOX_DRIVER=local

# --- Server --------------------------------------------------------------
NODE_ENV=development            # development | test | production
PORT=8787                       # API listen port
HOST=0.0.0.0                    # API bind address
PUBLIC_URL=http://localhost:5173  # where the web app is served (CORS origin, links in prompts)
API_URL=http://localhost:8787   # public base URL of this API (service endpoints, sites)
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace

# --- Database ------------------------------------------------------------
DATABASE_URL=postgres://localhost:5432/vantra

# --- Secrets -------------------------------------------------------------
# 32+ chars; signs session cookies AND peppers the claim-code HMAC. Changing it invalidates every
# outstanding claim code. In dev an insecure default is used with a warning.
SESSION_SECRET=
# 64 hex chars (32 bytes) for AES-256-GCM encryption of agent and deposit keypairs at rest.
# Generate: openssl rand -hex 32   (REQUIRED in production; dev falls back to a fixed key)
KEY_ENCRYPTION_KEY=

# --- Chain (Robinhood Chain, an Arbitrum Orbit L2; gas is ETH, settlement is USDC) ------
CHAIN_MODE=memory               # memory (in-process simulator, no keys) | robinhood
RHC_NETWORK=testnet             # testnet (chain id 46630) | mainnet (chain id 4663)
# The endpoint. CHAIN_MODE=robinhood refuses to inherit this default: name yours explicitly.
# Mainnet public (keyless, rate limited, no SLA): https://rpc.mainnet.chain.robinhood.com
# Testnet has no keyless endpoint: https://robinhood-testnet.g.alchemy.com/v2/<YOUR_KEY>
RHC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ALLOW_MAINNET=0                 # must be 1 to boot with RHC_NETWORK=mainnet: real money moves
# The settlement stablecoin, an ERC-20 address. Blank = mainnet USDC
# 0x80e0e24718dbFcad49ECAA6F1e6C89A190586cA8. USDG (deeper liquidity, also 6 decimals) is
# 0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168. REQUIRED on testnet: bridge test USDC and name it.
USDC_ADDRESS=
# TREASURY wallet (receives the net of every purchase, funds each agent's wallet, pays ETH gas
# stipends, receives withdraw fees): 0x-hex 32-byte private key, or the path to a JSON byte array.
# Generate one with: openssl rand -hex 32
TREASURY_WALLET_SECRET=
# FOUNDER FEE wallet (address only): receives FOUNDER_FEE_BPS of every purchase, straight from the
# buyer's deposit address. This is the platform's only margin.
FOUNDER_FEE_WALLET=
FOUNDER_FEE_BPS=1000            # 10%. Range 0–3000; the rest of every purchase is the agent's money.
# Receives swept inference/rent/tool spend from agent wallets (settlement). Address only.
PROTOCOL_FEE_WALLET=
# Custodies bounty escrow: 0x-hex private key or path to a JSON byte array
ESCROW_WALLET_SECRET=
ETH_PRICE_USD=3000              # fallback ETH price (memory mode / when the spot API is down)
ACCEPT_ETH_DEPOSITS=1           # value ETH sent to a deposit address at the current price
# LI.FI is the swap aggregator agents trade through (li.quest). Keyless; a key only lifts the limit.
LIFI_API_KEY=

# --- Agent token launches (Pons V2, the launchpad on Robinhood Chain) -----
# Off by default. When on, an agent's owner can launch its coin; the creator tax below accrues to
# the agent's OWN wallet forever, is fixed into the launch and cannot be rewired afterwards.
TOKEN_LAUNCH_ENABLED=0
PONS_CREATOR_TAX_BPS=1000       # 10%, the maximum the Pons factory accepts (maxCreatorTaxBps)

# --- Launchpad (a dev launches a coin whose creator tax funds a fresh AI) -----------------------
# The AI is born dormant and wakes once its claimable fees reach LAUNCH_ACTIVATION_USD; the treasury
# then sends it ACTIVATION_GAS_GWEI (0.0003 ETH) so it can sign its first claim. Anything it holds
# beyond BURN_RUNWAY_FLOOR_DAYS of runway (and at least MIN_BURN_USD) buys back and burns its coin.
# The dev may switch its model to an unlocked rung only if MODEL_SWITCH_MIN_RUNWAY_DAYS remain on it.
LAUNCH_ACTIVATION_USD=10
ACTIVATION_GAS_GWEI=300000
BURN_RUNWAY_FLOOR_DAYS=30
MIN_BURN_USD=5
MODEL_SWITCH_MIN_RUNWAY_DAYS=7

# --- Purchases -----------------------------------------------------------
MIN_PURCHASE_USD=10             # the floor of the SPARK tier; must be >= 1
MAX_PURCHASE_USD=1000
PURCHASE_TTL_HOURS=72           # how long a one-time deposit address stays live
DEPOSIT_POLL_MS=                # default: 2000 in memory mode, 10000 in robinhood mode

# --- LLM -----------------------------------------------------------------
LLM_PROVIDER=mock               # router (real provider keys) | x402 (agents pay per call in USDC) | mock (scripted, free)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Comma-separated model ids to allow (empty = whole catalog for providers with keys)
LLM_ALLOWED_MODELS=

# x402 mode (LLM_PROVIDER=x402): each agent pays an OpenAI-compatible x402 LLM gateway per call from
# its OWN Robinhood Chain wallet (USDC, HTTP 402) — no provider key is used. Requires
# CHAIN_MODE=robinhood. Set LLM_ALLOWED_MODELS to the ids your gateway serves; X402_MAX_PRICE_USD
# caps a single payment.
X402_GATEWAY_URL=               # e.g. https://your-x402-gateway/v1
X402_MAX_PRICE_USD=0.50

# --- Search --------------------------------------------------------------
SEARCH_PROVIDER=none            # brave | tavily | none
BRAVE_API_KEY=
TAVILY_API_KEY=

# --- Sandbox -------------------------------------------------------------
SANDBOX_DRIVER=local            # docker (isolated, production) | local (child_process, DEV ONLY — refused in production)
                                # | none (no code sandbox: bash, files, deploy_site and the service market are withheld)
SANDBOX_IMAGE=vantra-sandbox:latest
SANDBOX_NETWORK=vantra-agents   # dedicated bridge for agent containers (created on demand, inter-container comms off)
SANDBOX_EGRESS_FILTERED=0       # docker only: 1 = the host drops private-range egress from that bridge; REQUIRED with docker in production
DATA_DIR=./data                 # sandboxes, deployed sites (relative paths resolve from the repo root)
# Base URL for deployed agent sites; production: https://sites.vantra.xyz
SITES_BASE_URL=http://localhost:8787/sites

# --- Economy -------------------------------------------------------------
RENT_PER_HOUR_USD=0.005         # rent while alive (~$0.12/day); sleeping agents pay a fifth of it
MAX_CONCURRENT_STEPS=4          # scheduler parallelism
# DEV ONLY: force every new agent's heartbeat, in minutes. Refused when NODE_ENV=production.
# `pnpm demo` sets it to 5 so a locally bought agent visibly thinks.
HEARTBEAT_OVERRIDE_MIN=
# Wallets verified as genuine outside customers (a merchant of record, a settlement wallet). Everything
# else must prove itself — a matched user service call or a user-posted bounty — or it books as
# `revenue_pending` and never counts toward external revenue. Comma-separated; DEMO=1 adds the demo customers.
EXTERNAL_PAYER_WALLETS=

# --- Demo colony ---------------------------------------------------------
DEMO=0                          # 1 = seed a demo colony at boot and enable POST /api/auth/demo
DEMO_SEED=42                    # PRNG seed; same seed → same colony
DEMO_AGENTS=36
DEMO_DAYS=45
DEMO_TREASURY_USD=2000          # memory chain funds the treasury wallet with this much simulated USDC
# The demo also leaves two purchases pending and unpaid (LANTERN, TROVE) so /buy/:id is live on a
# fresh database. Their claim codes are hashed like any other and are never printed.

# --- Web (apps/web/.env) -------------------------------------------------
# Vite reads its env from apps/web, not from here: put this one in apps/web/.env.
# Browser RPC endpoint for Robinhood Chain reads. Unset = the API's own /rpc proxy (same origin in
# production, vite-proxied in dev), which is what a real deployment wants: it keeps the provider key
# server-side. Set it only to point the browser straight at an endpoint of your own.
VITE_RHC_RPC_URL=
